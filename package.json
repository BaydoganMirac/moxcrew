{
  "name": "patchfleet",
  "version": "0.5.0",
  "description": "Native Rust desktop command center for local coding-agent teams.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/BaydoganMirac/patchfleet#readme",
  "bugs": "https://github.com/BaydoganMirac/patchfleet/issues",
  "keywords": [
    "ai-agents",
    "claude-code",
    "codex",
    "gemini-cli",
    "local-first"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BaydoganMirac/patchfleet.git"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "cargo run -p patchfleet-desktop",
    "build": "cargo build --locked --release -p patchfleet-desktop",
    "start": "cargo run -p patchfleet-desktop",
    "desktop:dev": "cargo run -p patchfleet-desktop",
    "desktop:build": "cargo build --locked --release -p patchfleet-desktop",
    "desktop:package": "cargo packager --config Packager.toml",
    "test": "cargo test --locked --workspace",
    "legacy:dev": "node scripts/local-next.mjs dev",
    "legacy:build": "next build && node scripts/sanitize-package.mjs",
    "legacy:start": "node scripts/local-next.mjs start",
    "legacy:test": "node --test --test-concurrency=1 tests/*.test.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5",
    "next": "15.5.19",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.10"
    }
  },
  "private": true
}
